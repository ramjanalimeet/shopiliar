{
  "name": "shopiliar",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker handles the account API and checks sign-in before serving /admin
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "shopiliar-db", "database_id": "45d1c9c1-3aa1-4ac7-900d-322fc8a738ca" }
  ],
  // Sign-in / sign-up attempts per visitor IP
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
