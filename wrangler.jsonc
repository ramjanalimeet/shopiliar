{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopiliar",
  // The Next.js app, bundled for Workers by @opennextjs/cloudflare (`npm run deploy`)
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "shopiliar-db", "database_id": "45d1c9c1-3aa1-4ac7-900d-322fc8a738ca" }
  ],
  // Sign-in / sign-up attempts per visitor IP
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // Workers AI writes the first draft of a website in "Create with AI"
  "ai": { "binding": "AI" },
  // Cloudflare Access app that protects /master-admin (team domain and Application Audience tag)
  "vars": {
    "ACCESS_TEAM_DOMAIN": "muddy-hat-9802.cloudflareaccess.com",
    "ACCESS_AUD": "caa0b5cfd1121879a6a8096cb273c8bf7ed16d0c825dcab038f273729a8ce31f"
  },
  "observability": { "enabled": true }
}
